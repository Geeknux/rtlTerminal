+#[test]
+fn paragraph_bidi_hard_newline_and_reflow() {
+    use wezterm_bidi::{BidiContext, ParagraphDirectionHint};
+    let hint = ParagraphDirectionHint::AutoLeftToRight;
+    let mut term = TestTerm::new(20, 6, 100);
+    term.print("سلام  (abc) دنیا 123 می\u{200c}خواهم\r\nEnglish (فارسی) 42!\r\nمستعمرهنشینان");
+    term.screen_mut()
+        .for_each_phys_line_mut(|_, line| line.set_bidi_info(true, hint, 1));
+    for cols in [6, 11, 8, 40, 7] {
+        term.resize(TerminalSize {
+            rows: 20,
+            cols,
+            pixel_width: 0,
+            pixel_height: 0,
+            dpi: 96,
+        });
+        let count = term.screen().scrollback_rows();
+        term.screen_mut().with_phys_lines_mut(0..count, |rows| {
+            let mut start = 0;
+            while start < rows.len() {
+                let mut end = start + 1;
+                while end < rows.len() && rows[end - 1].last_cell_was_wrapped() {
+                    end += 1;
+                }
+                let mut chars = vec![];
+                let mut ranges = vec![];
+                for row in &rows[start..end] {
+                    assert!(row.bidi_info().0, "bidi lost on resize");
+                    let first = chars.len();
+                    for cell in row.visible_cells() {
+                        chars.extend(cell.str().chars());
+                    }
+                    ranges.push(first..chars.len());
+                }
+                let mut context = BidiContext::new();
+                context.resolve_paragraph(&chars, hint);
+                for (row, range) in rows[start..end].iter().zip(ranges) {
+                    assert_eq!(
+                        row.resolved_bidi_direction(),
+                        context.base_level().direction()
+                    );
+                    let expected: String = context
+                        .reordered_runs(range)
+                        .into_iter()
+                        .map(|r| chars[r.range].iter().collect::<String>())
+                        .collect();
+                    let actual: String = row
+                        .cluster(Some(hint))
+                        .iter()
+                        .map(|c| c.text.as_str())
+                        .collect();
+                    assert_eq!(actual, expected, "width {cols}");
+                    assert_eq!(
+                        row.cluster(Some(hint))
+                            .iter()
+                            .map(|c| c.width)
+                            .sum::<usize>(),
+                        row.visible_cells().map(|c| c.width()).sum::<usize>()
+                    );
+                }
+                start = end;
+            }
+        });
+    }
+}
