+    /// Resolve UBA over complete retained logical lines, including context
+    /// outside the viewport. Only soft-wrap flags join rows; hard newlines
+    /// and changes of bidi mode delimit paragraphs.
+    fn resolve_paragraph_bidi(&mut self, requested: Range<PhysRowIndex>) {
+        use wezterm_bidi::BidiContext;
+        use wezterm_surface::cellcluster::BidiLine;
+        let mut start = requested.start.min(self.lines.len());
+        if start >= self.lines.len() || requested.is_empty() {
+            return;
+        }
+        while start > 0
+            && self.lines[start - 1].last_cell_was_wrapped()
+            && self.lines[start - 1].bidi_info() == self.lines[start].bidi_info()
+        {
+            start -= 1;
+        }
+        while start < requested.end.min(self.lines.len()) {
+            let mode = self.lines[start].bidi_info();
+            let mut end = start + 1;
+            while end < self.lines.len()
+                && self.lines[end - 1].last_cell_was_wrapped()
+                && self.lines[end].bidi_info() == mode
+            {
+                end += 1;
+            }
+            if mode.0 {
+                let mut text = Vec::new();
+                let mut ranges = Vec::new();
+                for line in self.lines.iter().skip(start).take(end - start) {
+                    let first = text.len();
+                    for cell in line.visible_cells() {
+                        text.extend(cell.str().chars());
+                    }
+                    ranges.push(first..text.len());
+                }
+                let mut context = BidiContext::new();
+                context.resolve_paragraph(&text, mode.1);
+                for (row, range) in (start..end).zip(ranges) {
+                    let offset = range.start;
+                    let runs = context
+                        .reordered_runs(range)
+                        .into_iter()
+                        .map(|r| ((r.range.start - offset..r.range.end - offset), r.direction))
+                        .collect();
+                    self.lines[row].set_paragraph_bidi(Some(BidiLine {
+                        direction: context.base_level().direction(),
+                        runs,
+                    }));
+                }
+            } else {
+                for row in start..end {
+                    self.lines[row].set_paragraph_bidi(None);
+                }
+            }
+            start = end;
+        }
+    }
