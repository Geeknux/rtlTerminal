+#[test]
+fn paragraph_bidi_context_change_invalidates_shape_hash() {
+    use wezterm_bidi::ParagraphDirectionHint;
+    let hint = ParagraphDirectionHint::AutoLeftToRight;
+    let mut term = TestTerm::new(5, 6, 10);
+    term.print("سلام  (abc) دنیا");
+    term.screen_mut()
+        .for_each_phys_line_mut(|_, line| line.set_bidi_info(true, hint, 1));
+    let mut before = [0; 16];
+    let mut seqno = 0;
+    term.screen_mut().with_phys_lines_mut(1..2, |rows| {
+        before = rows[0].compute_shape_hash();
+        seqno = rows[0].current_seqno();
+    });
+    term.screen_mut()
+        .line_mut(0)
+        .set_cell(0, Cell::new('A', CellAttributes::default()), 2);
+    term.screen_mut().with_phys_lines_mut(1..2, |rows| {
+        assert_ne!(
+            rows[0].compute_shape_hash(),
+            before,
+            "unchanged row must see edited paragraph context"
+        );
+        assert_eq!(rows[0].current_seqno(), seqno);
+    });
+}
