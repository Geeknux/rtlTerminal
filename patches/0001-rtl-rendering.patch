+#[test]
+fn paragraph_bidi_soft_wrap_context() {
+    use wezterm_bidi::{BidiContext, ParagraphDirectionHint};
+    let mut term = TestTerm::new(5, 6, 10);
+    let text = "سلام  (abc) دنیا";
+    term.print(text);
+    let hint = ParagraphDirectionHint::AutoLeftToRight;
+    term.screen_mut()
+        .for_each_phys_line_mut(|_, line| line.set_bidi_info(true, hint, 1));
+    let chars: Vec<char> = text.chars().collect();
+    let mut context = BidiContext::new();
+    context.resolve_paragraph(&chars, hint);
+    let expected: Vec<_> = context
+        .reordered_runs(6..12)
+        .into_iter()
+        .map(|run| (chars[run.range].iter().collect::<String>(), run.direction))
+        .collect();
+    term.screen_mut().with_phys_lines_mut(1..2, |lines| {
+        let actual: Vec<_> = lines[0]
+            .cluster(Some(hint))
+            .into_iter()
+            .map(|run| (run.text, run.direction))
+            .collect();
+        assert_eq!(actual, expected);
+    });
+}
