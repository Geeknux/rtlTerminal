+//! Pixel geometry for bidi rendering and its inverse mouse/cursor mapping.
+//! Cell indices stay logical; only the display geometry is proportional.
+use super::LineToElementShape;
+use std::ops::Range;
+use wezterm_bidi::Direction;
+
+/// Slack stays at the leading edge, never inside words or spaces. On
+/// overflow compress advances only (the Arabic glyph bitmaps keep their size).
+pub(super) fn rtl_run_metrics(span: f32, natural: f32) -> (f32, f32) {
+    let scale = if natural > span && natural > 0. {
+        span / natural
+    } else {
+        1.
+    };
+    ((span - natural).max(0.), scale)
+}
+
+#[derive(Debug)]
+pub(super) struct CellLayout {
+    pub glyph_x: Vec<Vec<f32>>,
+    pub spans: Vec<Range<f32>>,
+    pub cells: Vec<Option<Range<f32>>>,
+    pub rtl_cells: Vec<bool>,
+}
+
+impl CellLayout {
+    pub fn new(
+        shaped: &[LineToElementShape],
+        width: f32,
+        cell_width: f32,
+        width_scale: f32,
+        base: Direction,
+        num_cols: usize,
+    ) -> Self {
+        let total: usize = shaped.iter().map(|s| s.cluster.width).sum();
+        let mut x = if base == Direction::RightToLeft {
+            (width - total as f32 * cell_width).max(0.)
+        } else {
+            0.
+        };
+        let mut result = Self {
+            glyph_x: vec![],
+            spans: vec![],
+            cells: vec![None; num_cols],
+            rtl_cells: vec![false; num_cols],
+        };
+        for item in shaped {
+            let span = (item.cluster.width as f32 * cell_width).min((width - x).max(0.));
+            let rtl = item.cluster.direction == Direction::RightToLeft;
+            let natural = item.pixel_width * width_scale;
+            let (slack, scale) = if rtl {
+                rtl_run_metrics(span, natural)
+            } else {
+                (0., 1.)
+            };
+            let mut gx = x + slack;
+            let mut positions = vec![];
+            for info in item.glyph_info.iter() {
+                positions.push(gx);
+                let advance = if rtl {
+                    info.glyph.x_advance.get() as f32 * width_scale * scale
+                } else {
+                    info.pos.num_cells as f32 * cell_width
+                };
+                let logical = item.cluster.byte_to_cell_idx(info.cluster as usize);
+                let count = info.pos.num_cells as usize;
+                for n in 0..count {
+                    let visual = if rtl { count - n - 1 } else { n };
+                    let start = gx + advance * visual as f32 / count as f32;
+                    let end = gx + advance * (visual + 1) as f32 / count as f32;
+                    if let Some(cell) = result.cells.get_mut(logical + n) {
+                        *cell = Some(start..end);
+                        result.rtl_cells[logical + n] = rtl;
+                    }
+                }
+                gx += advance;
+            }
+            result.glyph_x.push(positions);
+            result.spans.push(x..x + span);
+            x += span;
+        }
+        result
+    }
+
+    pub fn range(&self, logical: Range<usize>) -> Vec<Range<f32>> {
+        let mut ranges: Vec<_> = logical
+            .filter_map(|idx| self.cells.get(idx)?.clone())
+            .collect();
+        ranges.sort_by(|a, b| a.start.total_cmp(&b.start));
+        let mut merged: Vec<Range<f32>> = vec![];
+        for range in ranges {
+            if let Some(last) = merged.last_mut() {
+                if (last.end - range.start).abs() < 0.01 {
+                    last.end = range.end;
+                    continue;
+                }
+            }
+            merged.push(range);
+        }
+        merged
+    }
+
+    pub fn hit(&self, x: f32) -> Option<usize> {
+        if !self.spans.iter().any(|r| r.contains(&x)) {
+            return None;
+        }
+        self.cells
+            .iter()
+            .enumerate()
+            .filter_map(|(idx, r)| {
+                let r = r.as_ref()?;
+                let distance = if x < r.start {
+                    r.start - x
+                } else if x >= r.end {
+                    x - r.end
+                } else {
+                    0.
+                };
+                Some((idx, distance))
+            })
+            .min_by(|a, b| a.1.total_cmp(&b.1))
+            .map(|(idx, _)| idx)
+    }
+
+    pub fn cursor(&self, logical: Range<usize>, cell_width: f32) -> Option<Range<f32>> {
+        if let Some(range) = self.range(logical.clone()).first() {
+            return Some(range.clone());
+        }
+        let previous = logical.start.checked_sub(1)?;
+        let range = self.cells.get(previous)?.as_ref()?;
+        Some(if self.rtl_cells[previous] {
+            (range.start - cell_width).max(0.)..range.start
+        } else {
+            range.end..range.end + cell_width
+        })
+    }
+}
