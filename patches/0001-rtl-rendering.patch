+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn arabic_natural_advances_and_logical_hit_roundtrip() {
+        use crate::glyphcache::GlyphCache;
+        use crate::shapecache::ShapedInfo;
+        use crate::utilsprites::RenderMetrics;
+        use config::{FontAttributes, TextStyle};
+        use std::rc::Rc;
+        use termwiz::cell::CellAttributes;
+        use termwiz::cellcluster::BidiLine;
+        use termwiz::surface::Line;
+        use wezterm_bidi::{BidiContext, ParagraphDirectionHint};
+        use wezterm_font::{shaper::PresentationWidth, FontConfiguration};
+        config::use_test_configuration();
+        let mut config = (*config::configuration()).clone();
+        config.font = TextStyle {
+            font: vec![FontAttributes::new("Vazirmatn")],
+            foreground: None,
+        };
+        config.font_rules.clear();
+        config.compute_extra_defaults(None);
+        config::use_this_configuration(config);
+        let fonts = Rc::new(FontConfiguration::new(None, 96).unwrap());
+        let metrics = RenderMetrics::new(&fonts).unwrap();
+        let mut cache = GlyphCache::new_in_memory(&fonts, 1024).unwrap();
+        let style = TextStyle::default();
+        let font = fonts.resolve_font(&style).unwrap();
+        for text in [
+            "سلام دنیا این یک آزمایش است",
+            "فایل config.json را (123) ویرایش کن",
+            "می\u{200c}خواهم کتاب\u{200c}ها",
+            "بِسمِ الله",
+            "مستعمرهنشینان",
+            "abc 123 -> xyz",
+        ] {
+            let mut line = Line::from_text(text, &CellAttributes::default(), 1, None);
+            let chars: Vec<char> = text.chars().collect();
+            let mut bidi = BidiContext::new();
+            bidi.resolve_paragraph(&chars, ParagraphDirectionHint::AutoLeftToRight);
+            line.set_paragraph_bidi(Some(BidiLine {
+                direction: bidi.base_level().direction(),
+                runs: bidi
+                    .reordered_runs(0..chars.len())
+                    .into_iter()
+                    .map(|r| (r.range, r.direction))
+                    .collect(),
+            }));
+            let mut shaped = vec![];
+            for cluster in line.cluster(Some(ParagraphDirectionHint::AutoLeftToRight)) {
+                let info = font
+                    .shape(
+                        &cluster.text,
+                        || {},
+                        |_| {},
+                        None,
+                        cluster.direction,
+                        None,
+                        Some(&PresentationWidth::with_cluster(&cluster)),
+                    )
+                    .unwrap();
+                let glyphs: Vec<_> = info
+                    .iter()
+                    .map(|i| {
+                        cache
+                            .cached_glyph(
+                                i,
+                                &style,
+                                false,
+                                &font,
+                                &metrics,
+                                cluster.byte_to_cell_width(i.cluster as usize),
+                            )
+                            .unwrap()
+                    })
+                    .collect();
+                let glyph_info = Rc::new(ShapedInfo::process(&info, &glyphs));
+                shaped.push(LineToElementShape {
+                    underline_tex_rect: window::bitmaps::TextureRect::default(),
+                    fg_color: window::color::LinearRgba::default(),
+                    bg_color: window::color::LinearRgba::default(),
+                    underline_color: window::color::LinearRgba::default(),
+                    x_pos: 0.,
+                    pixel_width: glyph_info
+                        .iter()
+                        .map(|i| i.glyph.x_advance.get() as f32)
+                        .sum(),
+                    glyph_info,
+                    cluster,
+                });
+            }
+            let cw = metrics.cell_size.width as f32;
+            let layout = CellLayout::new(
+                &shaped,
+                100. * cw,
+                cw,
+                1.,
+                bidi.base_level().direction(),
+                100,
+            );
+            for cell in line.visible_cells() {
+                for logical in cell.cell_index()..cell.cell_index() + cell.width() {
+                    let r = layout.cells[logical]
+                        .as_ref()
+                        .unwrap_or_else(|| panic!("missing {} in {:?}", logical, text));
+                    if r.end > r.start {
+                        assert_eq!(
+                            layout.hit((r.start + r.end) / 2.),
+                            Some(logical),
+                            "{text:?}"
+                        );
+                    }
+                }
+            }
+            for (run, item) in shaped.iter().enumerate() {
+                if item.cluster.direction != Direction::RightToLeft {
+                    continue;
+                }
+                if item.pixel_width <= item.cluster.width as f32 * cw {
+                    for i in 1..item.glyph_info.len() {
+                        let step = layout.glyph_x[run][i] - layout.glyph_x[run][i - 1];
+                        let expected = item.glyph_info[i - 1].glyph.x_advance.get() as f32;
+                        assert!(
+                            (step - expected).abs() < 0.01,
+                            "space/letter advance altered: {:?}",
+                            text
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn logical_selection_can_have_disjoint_visual_spans() {
+        let layout = CellLayout {
+            glyph_x: vec![],
+            spans: vec![10.0..25.0],
+            cells: vec![Some(20.0..25.0), Some(10.0..15.0), Some(15.0..20.0)],
+            rtl_cells: vec![false, true, false],
+        };
+        assert_eq!(layout.range(0..2), vec![10.0..15.0, 20.0..25.0]);
+        assert_eq!(layout.range(0..3), vec![10.0..25.0]);
+        assert_eq!(layout.hit(22.), Some(0));
+        assert_eq!(layout.hit(11.), Some(1));
+        assert_eq!(layout.hit(18.), Some(2));
+    }
